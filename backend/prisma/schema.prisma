datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User status options representing active status boundary states
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Security compliance audit actions log catalog options
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  PASSWORD_CHANGE_SUCCESS
  STUDENT_ADMITTED
  STUDENT_UPDATED
  STUDENT_STATUS_CHANGED
  STUDENT_DELETED
  STUDENT_PROMOTED
  TEACHER_REGISTERED
  TEACHER_UPDATED
  TEACHER_STATUS_CHANGED
  TEACHER_ARCHIVED
}

// User account identity entity mapping
model User {
  id            String               @id @default(uuid())
  email         String               @unique
  password      String
  fullName      String
  roleId        String
  role          Role                 @relation(fields: [roleId], references: [id])
  status        UserStatus           @default(ACTIVE)
  lastLogin     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  resetTokens   PasswordResetToken[]

  @@map("users")
}

// System authorization role entity mapping
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

// System authorization permission privilege entity mapping
model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

// Many-to-Many junction relationship map for Roles and Permissions
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Authentication session Refresh Token storage mapping
model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  deviceType String?
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("refresh_tokens")
}

// Password reset token storage mapping for the Forgot Password flow
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Singleton school identity, contact, and location profile record
model SchoolProfile {
  id            String   @id @default(uuid())
  name          String   @default("My School")
  shortName     String?
  motto         String?
  description   String?
  phone         String?
  email         String?
  website       String?
  address       String?
  province      String?
  district      String?
  municipality  String?
  ward          String?
  postalCode    String?
  googleMapLink String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("school_profile")
}

// Singleton branding assets and document/report visual identity record
model SchoolBranding {
  id                    String   @id @default(uuid())
  logoUrl               String?
  faviconUrl            String?
  stampUrl              String?
  principalSignatureUrl String?
  reportHeaderImageUrl  String?
  reportFooterImageUrl  String?
  primaryColor          String?
  secondaryColor        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("school_branding")
}

// Fixed leadership role slots available for staffing
enum LeadershipRole {
  PRINCIPAL
  VICE_PRINCIPAL
  ADMINISTRATOR
  ACCOUNT_OFFICER
}

// School leadership directory entry mapped one-to-one per role
model Leadership {
  id           String         @id @default(uuid())
  role         LeadershipRole @unique
  name         String         @default("")
  designation  String?
  photoUrl     String?
  signatureUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("leadership")
}

// Attendance capture method options
enum AttendanceMethod {
  ADMIN_ONLY
  TEACHER
  BIOMETRIC
}

// Singleton system-wide regional and operational preferences record
model SchoolSettings {
  id               String           @id @default(uuid())
  timezone         String           @default("Asia/Kathmandu")
  language         String           @default("en")
  currency         String           @default("NPR")
  dateFormat       String           @default("YYYY-MM-DD")
  timeFormat       String           @default("HH:mm")
  weekStartsOn     Int              @default(0)
  defaultPassword  String           @default("Password123")
  attendanceMethod AttendanceMethod @default(ADMIN_ONLY)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("school_settings")
}

// Configurable academic term catalog entry (terminals, semesters, etc.)
model AcademicTerm {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_terms")
}

// Configurable grading scale band entry
model GradingScale {
  id            String   @id @default(uuid())
  grade         String   @unique
  minPercentage Float
  maxPercentage Float
  gpa           Float?
  description   String?
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("grading_scales")
}

// Academic year lifecycle status options
enum AcademicYearStatus {
  ACTIVE
  ARCHIVED
}

// School academic year catalog with one designated current year
model AcademicYear {
  id                      String                   @id @default(uuid())
  label                   String                   @unique
  startDate               DateTime
  endDate                 DateTime
  isCurrent               Boolean                  @default(false)
  status                  AcademicYearStatus       @default(ACTIVE)
  classes                 Class[]
  examTypes               ExamType[]
  enrollments             Enrollment[]
  admissionNumberSequence AdmissionNumberSequence?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@map("academic_years")
}

// Reference-data lifecycle status shared by Academic Structure entities
enum RecordStatus {
  ACTIVE
  ARCHIVED
}

// School grade/class catalog entry scoped to a single academic year
model Class {
  id             String         @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  displayOrder   Int
  description    String?
  status         RecordStatus   @default(ACTIVE)
  sections       Section[]
  classSubjects  ClassSubject[]
  enrollments    Enrollment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([academicYearId, name])
  @@map("classes")
}

// Class subdivision entry (e.g. Section A, B, C)
model Section {
  id          String       @id @default(uuid())
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  name        String
  capacity    Int?
  roomNumber  String?
  status      RecordStatus @default(ACTIVE)
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([classId, name])
  @@map("sections")
}

// Global reusable subject master catalog entry
model Subject {
  id            String         @id @default(uuid())
  name          String         @unique
  code          String?        @unique
  description   String?
  isOptional    Boolean        @default(false)
  status        RecordStatus   @default(ACTIVE)
  classSubjects ClassSubject[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("subjects")
}

// Per-class subject assignment with marks configuration
model ClassSubject {
  id                 String   @id @default(uuid())
  classId            String
  class              Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId          String
  subject            Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  fullMarks          Int
  passMarks          Int
  hasPractical       Boolean  @default(false)
  theoryMarks        Int?
  practicalMarks     Int?
  practicalPassMarks Int?
  // Nullable, additive FK onto the Faculty Management Engine — a deliberate,
  // minimal exception to "don't redesign shipped engines" (see
  // docs/architecture/faculty-engine-design-spec.md §2). Not every
  // ClassSubject has an assigned teacher yet, so this stays optional.
  teacherId          String?
  teacher            Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// Reusable examination template scoped to an academic year (e.g. First
// Terminal, Mid-Term, Final, Practical). Actual scheduled exam instances
// (ExamType x Date x Class x Section) belong to a future Examination Engine
// and are intentionally not modeled here.
model ExamType {
  id             String       @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  description    String?
  displayOrder   Int
  weightage      Float
  isPublished    Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, name])
  @@map("exam_types")
}

// Student lifecycle status — distinct from reference-data's ACTIVE/ARCHIVED
// because a student's departure reason (graduated vs. withdrawn vs.
// transferred to another school) matters for records and reporting.
enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
}

enum StudentDocumentType {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  CHARACTER_CERTIFICATE
  PHOTO
  OTHER
}

// Student Admission Engine — Student is the outcome of the admission
// workflow (see student.service.ts admitStudent), not a bare CRUD entity.
// Class/Section placement lives on Enrollment (below), not here, so a
// student's placement history survives year-over-year promotion.
model Student {
  id              String @id @default(uuid())
  admissionNumber String @unique

  firstName  String
  middleName String?
  lastName   String

  dateOfBirth DateTime
  gender      Gender
  photoUrl    String?

  // Address
  address               String?
  province              String?
  district              String?
  municipality          String?
  ward                  String?
  temporaryAddress      String?
  temporaryProvince     String?
  temporaryDistrict     String?
  temporaryMunicipality String?
  temporaryWard         String?

  // Medical information
  bloodGroup            String?
  allergies             String?
  medicalConditions     String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Previous school
  previousSchoolName        String?
  previousSchoolBoard       String?
  lastClassCompleted        String?
  transferCertificateNumber String?

  // Forward reference — no Finance Engine yet; migrates to a FK once one exists.
  feeCategory String?

  admissionDate DateTime          @default(now())
  status        StudentStatus     @default(ACTIVE)
  guardians     StudentGuardian[]
  documents     StudentDocument[]
  enrollments   Enrollment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("students")
}

// One row per academic year a student is placed into a Class/Section — the
// history that direct classId/sectionId fields on Student would have erased
// on promotion. rollNumber is per-enrollment (per year/section), not global.
// Promotion/Transfer engines (future) create/close Enrollment rows; this
// sprint only creates the first one, at admission time.
model Enrollment {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  classId        String
  class          Class        @relation(fields: [classId], references: [id])
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  rollNumber     Int?
  enrolledAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, sectionId, rollNumber])
  @@map("enrollments")
}

// Fixed Father/Mother/Guardian relations — at most one row per relation per student.
model StudentGuardian {
  id         String           @id @default(uuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relation   GuardianRelation
  fullName   String
  phone      String
  email      String?
  occupation String?
  address    String?

  @@unique([studentId, relation])
  @@map("student_guardians")
}

model StudentDocument {
  id           String              @id @default(uuid())
  studentId    String
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType StudentDocumentType
  fileUrl      String
  uploadedAt   DateTime            @default(now())

  @@map("student_documents")
}

// Internal counter for admission-number generation — one row per academic
// year, incremented inside the same transaction as the Student create so
// concurrent admissions can't collide. Not exposed via CRUD.
model AdmissionNumberSequence {
  academicYearId String       @id
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  lastNumber     Int          @default(0)

  @@map("admission_number_sequences")
}

// Security compliance audit logging record mapping
model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  action    AuditAction
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime    @default(now())

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Faculty Management Engine — see docs/architecture/faculty-engine-design-spec.md
// ─────────────────────────────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
}

// Lifecycle status — distinct from RecordStatus for the same reason
// StudentStatus is distinct from it: *why* someone left matters for records.
// Unlike StudentStatus, every terminal value here is reversible back to
// ACTIVE (rehire case) — this engine has no Enrollment-style history table
// that reopening a record would corrupt.
enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
}

enum TeacherDocumentType {
  CITIZENSHIP
  ACADEMIC_CERTIFICATE
  EXPERIENCE_LETTER
  APPOINTMENT_LETTER
  PAN_CARD
  PHOTO
  OTHER
}

// Reference data — mirrors Subject's shape (name/code/status), owned here
// rather than by the Academic Engine, since departments are an HR concept.
model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String?      @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  teachers    Teacher[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("departments")
}

// Reference data — small ordered list (Principal, Vice Principal, HOD,
// Senior Teacher, Teacher, ...). displayOrder drives hierarchy sort in the
// UI, the same role GradingScale.order and Class.displayOrder play elsewhere.
model Designation {
  id           String       @id @default(uuid())
  name         String       @unique
  displayOrder Int
  description  String?
  status       RecordStatus @default(ACTIVE)
  teachers     Teacher[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("designations")
}

// Faculty Management Engine — Teacher is reference data other engines
// (Attendance, Examination, Finance) hold teacherId FKs into, the same way
// Class/Section are owned by the Academic Engine. Not a bare CRUD entity:
// registration runs through a workflow that generates an employeeId, the
// same shape as Student admission.
model Teacher {
  id         String @id @default(uuid())
  employeeId String @unique

  firstName  String
  middleName String?
  lastName   String

  dateOfBirth DateTime
  gender      Gender
  photoUrl    String?
  bloodGroup  String?

  phone String  @unique
  email String? @unique

  address      String?
  province     String?
  district     String?
  municipality String?
  ward         String?

  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id])
  designationId  String
  designation    Designation    @relation(fields: [designationId], references: [id])
  employmentType EmploymentType
  joiningDate    DateTime
  leavingDate    DateTime?
  status         TeacherStatus  @default(ACTIVE)

  // Forward reference — no Finance/Payroll Engine yet; same pattern as
  // Student.feeCategory. Gated behind teachers.salary, not
  // teachers.read/update, since compensation is more sensitive than a
  // profile edit — see docs/architecture/faculty-engine-design-spec.md §5/§7.
  basicSalary Decimal? @db.Decimal(10, 2)

  qualifications    TeacherQualification[]
  emergencyContacts TeacherEmergencyContact[]
  documents         TeacherDocument[]
  leaveBalance      TeacherLeaveBalance?
  classSubjects     ClassSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teachers")
}

model TeacherQualification {
  id            String   @id @default(uuid())
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  degree        String
  fieldOfStudy  String?
  institution   String
  yearCompleted Int
  createdAt     DateTime @default(now())

  @@map("teacher_qualifications")
}

// A teacher can list more than one contact (spouse + parent, etc.), unlike
// Student's fixed Father/Mother/Guardian relations — isPrimary (service-layer
// enforced: exactly one per teacher) marks which one gets called first.
model TeacherEmergencyContact {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  phone     String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("teacher_emergency_contacts")
}

model TeacherDocument {
  id           String              @id @default(uuid())
  teacherId    String
  teacher      Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  documentType TeacherDocumentType
  fileUrl      String
  uploadedAt   DateTime            @default(now())

  @@map("teacher_documents")
}

// Balance ledger only — no request/approval workflow here (that belongs to
// the future Attendance Engine's "Leave" scope). Attendance decrements the
// *Used fields when it approves a leave; this engine just exposes and lets
// HR adjust entitlements.
model TeacherLeaveBalance {
  teacherId         String   @id
  teacher           Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  annualEntitlement Int      @default(18)
  sickEntitlement   Int      @default(12)
  casualEntitlement Int      @default(6)
  annualUsed        Int      @default(0)
  sickUsed          Int      @default(0)
  casualUsed        Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@map("teacher_leave_balances")
}

// Global counter (not per-year like AdmissionNumberSequence) — staff persist
// across academic years, so employeeId doesn't reset annually. Single fixed
// row, same getOrCreate() singleton pattern as SchoolProfile/SchoolSettings.
model EmployeeNumberSequence {
  id         String @id @default("singleton")
  lastNumber Int    @default(0)

  @@map("employee_number_sequences")
}
